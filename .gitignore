# Only our own work goes in git. What is left out, and where each third-party file comes from:
# docs/DEVELOPER_GUIDE.md, "What is in git, and what is not".

# ---- build output ----
bin/
obj/
dist/
*.user
*.exp
*.lib
*.pdb
*.ilk
.vs/
.vscode/
.idea/

# the Unity plugins' build input, taken out of redist/'s BepInEx zip by rig\unity\build.ps1
rig/unity/lib/
# the Minecraft mod's Gradle build, and Gradle's own wrapper (third-party: docs/DEVELOPER_GUIDE.md)
rig/minecraft/build/
rig/minecraft/.gradle/
rig/minecraft/gradlew
rig/minecraft/gradlew.bat
rig/minecraft/gradle/wrapper/gradle-wrapper.jar

# ---- third-party: never in git ----
# redist/ holds what the installer puts into games. Only the files built from our own code are tracked: the add-on,
# the two Unity plugins, which can only be built against a game's own assemblies, and the Minecraft rig's two.
redist/*
!redist/voxon_capture_ue.addon64
!redist/VoxonCaptureRig.Unity.dll
!redist/VoxonCaptureRig.Unity.IL2CPP.dll
# the Minecraft rig: its Fabric mod (rig/minecraft) and its decode host (addon/minecraft_host.cpp)
!redist/VoxonCaptureRig.Minecraft.jar
!redist/voxon_capture_mc.exe
# and the rig's own Blueprint Loader mods (redist/blueprint/<game id>/), built by tools/mcdungeons2-mod
!redist/blueprint/

# ReShade's add-on SDK headers: fetched at the tag VENDORED.md names
addon/reshade-sdk/*
!addon/reshade-sdk/VENDORED.md

# the Voxon runtime: installed separately, never distributed with this
LedHost.dll
LedWin.dll
FTD3XXWU.dll
ledhost.ini

# ScriptHookV and its .asi loader: the player's to download
ScriptHookV*
*.asi
dinput8.dll

# c1-launcher (Crysis): the player's own download
c1-launcher*/

# ---- any game's files: none belong here; these catch an accident ----
*.pak
*.ucas
*.utoc
!redist/blueprint/*/VoxonRig_P.*
*.bundle
*.assets
*.resS
GameAssembly.dll
UnityPlayer.dll
global-metadata.dat
*.dmp

# ---- per-PC state the app and the tools write ----
settings/
control.txt
*.log
selftest.txt
.claude/settings.local.json
